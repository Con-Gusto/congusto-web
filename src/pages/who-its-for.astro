---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { audienceCards } from '../data/site';
---

<Layout
  title="Who Con Gusto Is For"
  description="Con Gusto is designed for property managers, contractors, and in-house employees who need clearer coordination around requests, field updates, and completion details."
>
  <PageHero
    eyebrow="Who It Is For"
    title="Different roles need different workflows, but they still need the same record of the work."
    description="Con Gusto is built around the real shape of property operations: managers, employees, and contractors all touch the same jobs from different angles and at different moments."
  />

  <section class="section">
    <div class="container audience-stack">
      {audienceCards.map((card) => (
        <article class="audience-detail section-panel">
          <div class="icon-badge icon-badge-soft">
            <Icon name={card.icon} />
          </div>
          <div>
            <strong>{card.title}</strong>
            <p class="card-summary">{card.summary}</p>
          </div>
          <p>{card.description}</p>
          <ul class="bullet-list">
            {card.bullets.map((bullet) => (
              <li>
                <Icon name="check-circle" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}

      <div class="cta-panel section-panel">
        <div>
          <div class="eyebrow">Why this matters</div>
          <h2>Property operations get slower when every role has to rebuild context from scratch.</h2>
          <p class="muted">
            Better visibility does not mean everyone needs the same screen. It means
            each person gets the details they need without losing the story behind the work.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/features">See platform capabilities</a>
          <a class="button button-secondary" href="/support">Talk to Con Gusto</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
