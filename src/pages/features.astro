---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { featureGroups, site } from '../data/site';
---

<Layout
  title="Con Gusto Features"
  description="Explore the Con Gusto feature set across job tracking, communication, mobile execution, and dashboard visibility."
>
  <PageHero
    eyebrow="Features"
    title="Built around operational flow, not around disconnected tools."
    description="Con Gusto is designed to connect incoming work, team coordination, field updates, and browser-based oversight into one operational system."
  />

  <section class="section">
    <div class="container">
      {featureGroups.map((group) => (
        <section class="feature-group">
          <div class="feature-group-header">
            <h3>{group.heading}</h3>
            <p>{group.summary}</p>
          </div>
          <div class="feature-grid">
            {group.items.map((item) => (
              <article class="feature-card">
                <div class="icon-badge">
                  <Icon name={item.icon} />
                </div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <div class="cta-panel">
        <div>
          <div class="eyebrow">Where this is headed</div>
          <h2>Features matter, but release quality matters more.</h2>
          <p class="muted">
            The product direction is not just about adding more screens. It is about
            making backend, mobile, and dashboard improvements easier to test and
            safer to ship over time.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/coming-soon">See What Is Coming</a>
          <a class="button-secondary" href={site.dashboardUrl} target="_blank" rel="noreferrer">
            Dashboard Login
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
