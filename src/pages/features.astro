---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { featureGroups } from '../data/site';
---

<Layout
  title="Con Gusto Features"
  description="Explore how Con Gusto connects request intake, assignments, field updates, role-based visibility, and closeout records in one property operations workflow."
>
  <PageHero
    eyebrow="What It Does"
    title="A single operating record for the work property teams coordinate every day."
    description="Con Gusto connects request intake, assignments, field updates, and management oversight in one operational flow instead of spreading the story across disconnected tools."
  />

  <section class="section">
    <div class="container">
      <div class="feature-hero-panel section-panel">
        <div>
          <div class="eyebrow">What teams actually need</div>
          <h2>Requests should move forward with context, not just with a status label.</h2>
          <p>
            The platform is focused on practical visibility: who owns the work, what
            happened at the property, what is still blocked, and what should happen next.
          </p>
        </div>
        <div class="callout-stack">
          <div class="callout-card">
            <strong>For managers</strong>
            <p>Better oversight across buildings, vendors, and in-house teams.</p>
          </div>
          <div class="callout-card">
            <strong>For the field</strong>
            <p>Faster updates with less duplication and fewer missing details.</p>
          </div>
        </div>
      </div>

      {featureGroups.map((group) => (
        <section class="feature-group section-panel">
          <div class="feature-group-header">
            <h3>{group.heading}</h3>
            <p>{group.summary}</p>
          </div>
          <div class="feature-grid">
            {group.items.map((item) => (
              <article class="feature-card">
                <div class="icon-badge icon-badge-soft">
                  <Icon name={item.icon} />
                </div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}

      <div class="cta-panel section-panel">
        <div>
          <div class="eyebrow">Need a closer look?</div>
          <h2>See the workflow on the site, then request a guided walkthrough of the rollout.</h2>
          <p class="muted">
            The public site explains the shape of the platform. Preview routes are
            reserved for controlled review while the broader rollout is still in progress.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/support" data-analytics-event="cta_request_walkthrough">Request a walkthrough</a>
          <a class="button button-secondary" href="/coming-soon" data-analytics-event="cta_view_rollout">See what is next</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
