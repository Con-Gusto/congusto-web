---
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Con Gusto Developer Preview"
  description="Developer preview information for internal review and controlled testing of Con Gusto staging surfaces."
  noIndex={true}
>
  <PageHero
    eyebrow="Developer Preview"
    title="Preview routes are for controlled review, not public rollout."
    description="This page exists so internal reviewers and collaborating developers know which surfaces are intended for preview testing while the broader platform rollout is still in progress."
  />

  <section class="section">
    <div class="container support-grid">
      <article class="support-card section-panel">
        <strong>Marketing preview</strong>
        <p>
          Use the preview marketing environment to review copy, layout, and visual changes
          before they move onto the public site.
        </p>
        <a class="inline-link" href={site.previewUrl} target="_blank" rel="noreferrer">
          {site.previewUrl}
        </a>
      </article>

      <article class="support-card section-panel">
        <strong>Dashboard preview</strong>
        <p>
          Staging dashboard routes are for in-progress review only and may not reflect
          public availability, backend readiness, or final product behavior.
        </p>
        <a class="inline-link" href={site.stagingDashboardUrl} target="_blank" rel="noreferrer">
          {site.stagingDashboardUrl}
        </a>
      </article>

      <article class="support-card section-panel">
        <strong>Public site</strong>
        <p>
          congustoapp.com remains the public marketing site. Keep public-facing copy
          aligned with what is actually live today.
        </p>
        <a class="inline-link" href={site.siteUrl} target="_blank" rel="noreferrer">
          {site.siteUrl}
        </a>
      </article>
    </div>
  </section>
</Layout>
