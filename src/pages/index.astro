---
import Icon from '../components/Icon.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Layout from '../layouts/Layout.astro';
import {
  audienceCards,
  coordinationTags,
  definitionCards,
  featureGroups,
  heroHighlights,
  rolloutStates,
  workflowSteps,
} from '../data/site';
---

<Layout
  title="Con Gusto | The shared workflow for property operations"
  description="Con Gusto is a property operations platform that keeps maintenance requests, assignments, field updates, and closeout records connected for property managers, contractors, and in-house teams."
>
  <section class="hero hero-home">
    <div class="container hero-grid hero-grid-home">
      <div class="hero-copy">
        <div class="eyebrow">Property operations platform</div>
        <h1>Con Gusto keeps property work visible from request to closeout.</h1>
        <p class="hero-lead">
          It gives property managers, contractors, and in-house teams one shared
          workflow for intake, assignments, field updates, and final completion records
          so the office and the field stay on the same page.
        </p>
        <div class="hero-actions">
          <a class="button" href="/support">
            <span>Request a walkthrough</span>
            <Icon name="arrow-right" />
          </a>
          <a class="button button-secondary" href="/features">See what it does</a>
        </div>
        <ul class="hero-points">
          {heroHighlights.map((item) => (
            <li>
              <span class="icon-badge icon-badge-soft">
                <Icon name="check-circle" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <ProductShowcase />
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="logo-strip section-panel">
        <div>
          <p class="eyebrow">Built for shared visibility</p>
          <h2>Made for the roles that touch the same job at different moments.</h2>
        </div>
        <div class="logo-slot-grid">
          {coordinationTags.map((slot) => (
            <div class="logo-slot">{slot}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-wide">
        <div class="eyebrow">What Con Gusto is</div>
        <h2>A property operations system built to keep work understandable as it moves.</h2>
        <p>
          The clearest way to describe Con Gusto is simple: it keeps the request, the
          assignment, the field update, and the completion record connected so the next
          person does not have to guess what happened before them.
        </p>
      </div>
      <div class="card-grid card-grid-definition">
        {definitionCards.map((card) => (
          <article class="definition-card section-panel">
            <div class="icon-badge">
              <Icon name={card.icon} />
            </div>
            <p class="card-kicker">{card.eyebrow}</p>
            <strong>{card.title}</strong>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading section-heading-wide">
        <div class="eyebrow">Who it is for</div>
        <h2>One operations layer, shaped for the people who manage, perform, and complete the work.</h2>
        <p>
          Property operations break down when each role sees only part of the picture.
          Con Gusto is designed to keep those views aligned without forcing everyone
          into the same screen or the same workflow.
        </p>
      </div>
      <div class="card-grid card-grid-roles">
        {audienceCards.map((card) => (
          <article class="audience-card section-panel">
            <div class="icon-badge">
              <Icon name={card.icon} />
            </div>
            <strong>{card.title}</strong>
            <p class="card-summary">{card.summary}</p>
            <p>{card.description}</p>
            <ul class="bullet-list">
              {card.bullets.map((bullet) => (
                <li>
                  <Icon name="check-circle" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <div class="section-heading sticky-copy">
        <div class="eyebrow">How it works</div>
        <h2>From intake to completion, each handoff keeps its context.</h2>
        <p>
          The goal is straightforward: make it easier to understand what was requested,
          who is handling it, and what happened on site without rebuilding the story
          every time work changes hands.
        </p>
      </div>
      <div class="workflow-steps">
        {workflowSteps.map((step, index) => (
          <article class="workflow-step section-panel">
            <div class="step-number">0{index + 1}</div>
            <span class="icon-badge icon-badge-soft">
              <Icon name={step.icon} />
            </span>
            <div>
              <strong>{step.title}</strong>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">What changes</div>
        <h2>Designed to reduce operational guesswork, not add another place to check.</h2>
        <p>
          Every screen should make the next action easier. That means shared timelines,
          clearer assignments, and field-ready updates that stay attached to the work.
        </p>
      </div>

      {featureGroups.map((group) => (
        <section class="feature-group section-panel">
          <div class="feature-group-header">
            <h3>{group.heading}</h3>
            <p>{group.summary}</p>
          </div>
          <div class="feature-grid">
            {group.items.map((item) => (
              <article class="feature-card">
                <div class="icon-badge icon-badge-soft">
                  <Icon name={item.icon} />
                </div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Rollout clarity</div>
        <h2>The site is public. The broader product rollout is still staged carefully.</h2>
        <p>
          That distinction matters. This website should make Con Gusto easy to
          understand without implying that every product surface is already generally available.
        </p>
      </div>
      <div class="support-grid">
        {rolloutStates.map((item) => (
          <article class="support-card section-panel">
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="cta-panel section-panel cta-panel-strong">
        <div>
          <div class="eyebrow">What you can do now</div>
          <h2>Use the public site to understand Con Gusto, then start with a walkthrough.</h2>
          <p class="muted">
            The product story is ready to review now. Access to broader product surfaces
            is still coordinated carefully, so walkthrough and rollout conversations should start through contact.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/support">Talk to Con Gusto</a>
          <a class="button button-secondary" href="/coming-soon">See rollout status</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
