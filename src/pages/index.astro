---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import {
  audienceCards,
  featureGroups,
  heroHighlights,
  logoSlots,
  workflowSteps,
} from '../data/site';
---

<Layout
  title="Con Gusto | Operational clarity for property teams"
  description="Con Gusto gives property managers, contractors, and employees a clearer way to move work from request to completion without losing status, context, or accountability."
>
  <section class="hero hero-home">
    <div class="container hero-grid hero-grid-home">
      <div class="hero-copy">
        <div class="eyebrow">Property operations, with fewer blind spots</div>
        <h1>See the full job story before details get lost between the office and the field.</h1>
        <p class="hero-lead">
          Con Gusto is designed for property managers, contractors, and employees who
          need work requests, updates, and completion details to stay visible from the
          first message through the final walkthrough.
        </p>
        <div class="hero-actions">
          <a class="button" href="/support">
            <span>Request a walkthrough</span>
            <Icon name="arrow-right" />
          </a>
          <a class="button button-secondary" href="/features">Explore the platform</a>
        </div>
        <ul class="hero-points">
          {heroHighlights.map((item) => (
            <li>
              <span class="icon-badge icon-badge-soft">
                <Icon name="check-circle" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside class="hero-product section-panel">
        <div class="hero-product-header">
          <span class="status-pill">Rollout in progress</span>
          <span class="muted">Space reserved for dashboard and brand assets</span>
        </div>

        <div class="product-frame">
          <div class="product-frame-window">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="product-frame-body">
            <div class="product-column product-column-main">
              <div class="product-card product-card-primary">
                <strong>Job queue</strong>
                <p>Urgent requests, assignments, and approvals stay attached to the same operational record.</p>
              </div>
              <div class="product-card-grid">
                <div class="product-card">
                  <strong>Property context</strong>
                  <p>Address, notes, and unit details live with the work.</p>
                </div>
                <div class="product-card">
                  <strong>Field updates</strong>
                  <p>Photos, notes, and status changes are captured in the moment.</p>
                </div>
              </div>
            </div>
            <div class="product-column product-column-side">
              <div class="product-card logo-placeholder-card">
                <span class="logo-slot-token">Logo slot</span>
                <p>Reserve space for future product mockups, partner marks, or rollout visuals.</p>
              </div>
              <div class="product-card">
                <strong>Role-based views</strong>
                <ul class="compact-list">
                  <li>Managers</li>
                  <li>Contractors</li>
                  <li>Employees</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="logo-strip section-panel">
        <div>
          <p class="eyebrow">Brand and proof space</p>
          <h2>Built to make room for future logos, product visuals, and customer proof.</h2>
        </div>
        <div class="logo-slot-grid">
          {logoSlots.map((slot) => (
            <div class="logo-slot">{slot}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-wide">
        <div class="eyebrow">Who it helps</div>
        <h2>One operations layer, shaped for the people who manage, perform, and complete the work.</h2>
        <p>
          Property operations break down when each role sees only part of the picture.
          Con Gusto is designed to keep those views aligned without forcing everyone
          into the same workflow.
        </p>
      </div>
      <div class="card-grid card-grid-roles">
        {audienceCards.map((card) => (
          <article class="audience-card section-panel">
            <div class="icon-badge">
              <Icon name={card.icon} />
            </div>
            <strong>{card.title}</strong>
            <p class="card-summary">{card.summary}</p>
            <p>{card.description}</p>
            <ul class="bullet-list">
              {card.bullets.map((bullet) => (
                <li>
                  <Icon name="check-circle" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container two-column">
      <div class="section-heading sticky-copy">
        <div class="eyebrow">How it works</div>
        <h2>From intake to completion, each handoff keeps its context.</h2>
        <p>
          The goal is straightforward: make it easier to understand what was requested,
          who is handling it, and what happened on site without rebuilding the story
          every time work changes hands.
        </p>
      </div>
      <div class="workflow-steps">
        {workflowSteps.map((step, index) => (
          <article class="workflow-step section-panel">
            <div class="step-number">0{index + 1}</div>
            <span class="icon-badge icon-badge-soft">
              <Icon name={step.icon} />
            </span>
            <div>
              <strong>{step.title}</strong>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Platform value</div>
        <h2>Designed to reduce operational guesswork, not add another place to check.</h2>
        <p>
          Every screen should make the next action easier. That means shared timelines,
          clearer assignments, and field-ready updates that stay attached to the work.
        </p>
      </div>

      {featureGroups.map((group) => (
        <section class="feature-group section-panel">
          <div class="feature-group-header">
            <h3>{group.heading}</h3>
            <p>{group.summary}</p>
          </div>
          <div class="feature-grid">
            {group.items.map((item) => (
              <article class="feature-card">
                <div class="icon-badge icon-badge-soft">
                  <Icon name={item.icon} />
                </div>
                <strong>{item.title}</strong>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="cta-panel section-panel cta-panel-strong">
        <div>
          <div class="eyebrow">What you can do today</div>
          <h2>Use the public site to understand the rollout. Use preview only for controlled testing.</h2>
          <p class="muted">
            congustoapp.com is the public marketing surface for Con Gusto. The
            broader backend and dashboard rollout are still being staged, so requests
            for access and walkthroughs should start through the contact page.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button" href="/support">Talk to Con Gusto</a>
          <a class="button button-secondary" href="/developer-preview">Developer preview</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
