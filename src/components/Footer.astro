---
import { footerLinks, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-copy">
        <div class="footer-brand">
          <span class="brand-mark">CG</span>
          <div>
            <strong>{site.name}</strong>
            <p>{site.tagline}</p>
          </div>
        </div>
        <p>
          The public site at congustoapp.com explains the Con Gusto product vision
          and rollout direction for property operations teams.
        </p>
        <div class="footer-note">
          The marketing site is live. Backend and broader product rollout are still
          being staged carefully.
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        {footerLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="footer-contact">
        <strong>Contact</strong>
        <a class="inline-link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        <a class="inline-link" href={site.previewUrl} target="_blank" rel="noreferrer">
          Preview environment
        </a>
      </div>
    </div>
  </div>
</footer>
