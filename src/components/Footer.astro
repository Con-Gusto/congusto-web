---
import BrandMark from './BrandMark.astro';
import { footerLinks, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-copy">
        <div class="footer-brand">
          <BrandMark />
        </div>
        <p>
          Con Gusto is a property operations platform for keeping requests,
          assignments, field updates, and closeout details connected in one workflow.
        </p>
        <div class="footer-note">
          The public site is live. Broader product access is still being rolled out carefully.
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        {footerLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="footer-contact">
        <strong>Contact</strong>
        <a class="inline-link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
        <a class="inline-link" href={site.previewUrl} target="_blank" rel="noreferrer">
          Preview environment
        </a>
      </div>
    </div>
  </div>
</footer>
