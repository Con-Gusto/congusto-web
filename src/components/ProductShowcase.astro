---
import {
  showcaseActivity,
  showcaseBlurPattern,
  showcaseRoleStats,
  showcaseStatArrow,
  showcaseWorkflowItems,
} from '../data/site';
---

<section class="section section-home-showcase" aria-labelledby="home-showcase-heading">
  <div class="showcase-blur" aria-hidden="true">
    <img src={showcaseBlurPattern} alt="" width={960} height={960} loading="lazy" decoding="async" />
  </div>

  <div class="container showcase-feat">
    <div class="showcase-feat-grid">
      <header class="showcase-feat-copy">
        <div class="eyebrow">Shared job record</div>
        <h2 id="home-showcase-heading">One request. One timeline. Every step visible.</h2>
        <p>
          A single operating record keeps intake, assignments, field updates, and closeout
          attached—so the next person never has to rebuild the story.
        </p>
        <span class="status-pill">Rollout in progress</span>
      </header>

      <div class="showcase-feat-items">
        {showcaseWorkflowItems.map((item, index) => (
          <article class="showcase-feat-item section-panel">
            <div
              class="showcase-feat-media"
              style={`background-image: url('${item.image}')`}
              role="img"
              aria-label={item.title}
            />
            <div class="showcase-feat-info">
              <div class="showcase-feat-meta">
                <span class="showcase-label">{item.label}</span>
                {'badge' in item && item.badge ? (
                  <span class="showcase-badge">{item.badge}</span>
                ) : null}
                {index === 0 ? (
                  <span class="showcase-live" aria-hidden="true">
                    <span class="showcase-live-dot" />
                    Live
                  </span>
                ) : null}
              </div>
              <strong>{item.title}</strong>
              <p>{item.description}</p>
              {'chips' in item && item.chips ? (
                <div class="showcase-chip-row">
                  {item.chips.map((chip) => (
                    <span class="showcase-chip">{chip}</span>
                  ))}
                </div>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="showcase-feat-bottom">
      <article class="showcase-timeline section-panel" aria-label="Latest activity example">
        <div class="showcase-feed-head">
          <span class="showcase-label">Latest activity</span>
          <span class="showcase-feed-count">3 updates today</span>
        </div>
        <ul class="showcase-feed">
          {showcaseActivity.map((entry) => (
            <li>
              <strong>{entry.time}</strong>
              <span>{entry.detail}</span>
            </li>
          ))}
        </ul>
      </article>

      <div class="showcase-stats section-panel" aria-label="Who benefits">
        <ul class="showcase-stats-list">
          {showcaseRoleStats.map((stat) => (
            <li class="showcase-stat">
              <div class="showcase-stat-copy">
                <span class="showcase-stat-label">{stat.label}</span>
                <strong>{stat.value}</strong>
              </div>
              <div class="showcase-stat-arrow" aria-hidden="true">
                <img src={showcaseStatArrow} alt="" width={40} height={40} loading="lazy" decoding="async" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
