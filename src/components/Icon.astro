---
interface Props {
  name:
    | 'arrow-right'
    | 'briefcase'
    | 'building'
    | 'camera'
    | 'check-circle'
    | 'inbox'
    | 'layers'
    | 'message'
    | 'monitor'
    | 'phone'
    | 'route'
    | 'shield'
    | 'users'
    | 'wrench';
